{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-retail-de-261123"
		},
		"ls_retail_crm_cosmos_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_retail_crm_cosmos'"
		},
		"ls_retail_pos_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_retail_pos_sql'"
		},
		"ls_retail_storage_mi_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_retail_storage_mi'"
		},
		"ls_retail_storage_sql_private_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_retail_storage_sql_private'"
		},
		"ls_retail_supplier_sftp_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_retail_supplier_sftp'"
		},
		"ls_retail_pos_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-retail-pos-261117019.database.windows.net"
		},
		"ls_retail_pos_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb-retail-pos"
		},
		"ls_retail_pos_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "test1"
		},
		"ls_retail_storage_mi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retailconn.dfs.core.windows.net/"
		},
		"ls_retail_storage_sql_private_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://retailconn.dfs.core.windows.net/"
		},
		"ls_retail_supplier_sftp_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "retailconn.blob.core.windows.net"
		},
		"ls_retail_supplier_sftp_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "retailconn.supplierdemo"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_retail_crm_cosmos')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "CosmosDb",
				"typeProperties": {
					"connectionString": "[parameters('ls_retail_crm_cosmos_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_retail_pos_sql')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_retail_pos_sql_properties_typeProperties_server')]",
					"database": "[parameters('ls_retail_pos_sql_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_retail_pos_sql_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_retail_pos_sql_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_retail_storage_mi')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_retail_storage_mi_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_retail_storage_mi_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_retail_storage_sql_private')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_retail_storage_sql_private_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('ls_retail_storage_sql_private_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_retail_supplier_sftp')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "Sftp",
				"typeProperties": {
					"host": "[parameters('ls_retail_supplier_sftp_properties_typeProperties_host')]",
					"port": 22,
					"skipHostKeyValidation": true,
					"authenticationType": "Basic",
					"userName": "[parameters('ls_retail_supplier_sftp_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_retail_supplier_sftp_password')]"
					}
				}
			},
			"dependsOn": []
