					"location": {
						"type": "AzureBlobStorageLocation",
						"fileName": {
							"value": "@dataset().fileName",
							"type": "Expression"
						},
						"folderPath": "warehouse-inventory/blob",
						"container": "landing"
					}
				}
			},
			"dependsOn": [
