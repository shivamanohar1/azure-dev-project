						},
						"container": "warehouse-inventory"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_retail_storage_mi')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_retail_crm_cosmos_incremental')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "CopyChangedCustomers",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "CosmosDbSqlApiSource",
								"query": {
									"value": "@concat('SELECT c.id, c.customer_id, c.name, c.city, c.updated_at FROM c WHERE c.updated_at > \"', formatDateTime(pipeline().parameters.fromUtc, 'yyyy-MM-ddTHH:mm:ssZ'), '\" AND c.updated_at <= \"', formatDateTime(pipeline().parameters.toUtc, 'yyyy-MM-ddTHH:mm:ssZ'), '\"')",
									"type": "Expression"
								},
								"preferredRegions": []
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings",
									"filePattern": "arrayOfObjects"
								}
							},
							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"mappings": [
									{
										"source": {
											"path": "$['id']"
										},
										"sink": {
											"path": "$['id']"
										}
									},
									{
										"source": {
											"path": "$['customer_id']"
										},
										"sink": {
											"path": "$['customer_id']"
										}
									},
									{
										"source": {
											"path": "$['name']"
										},
										"sink": {
											"path": "$['name']"
										}
									},
									{
										"source": {
											"path": "$['city']"
										},
										"sink": {
											"path": "$['city']"
										}
									},
									{
										"source": {
											"path": "$['updated_at']"
										},
										"sink": {
											"path": "$['updated_at']"
										}
									}
								]
							}
						},
						"inputs": [
							{
								"referenceName": "ds_retail_crm_cosmos",
								"type": "DatasetReference",
								"parameters": {}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_retail_crm_landing",
								"type": "DatasetReference",
								"parameters": {
									"batchId": {
										"value": "@pipeline().parameters.batchId",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"fromUtc": {
						"type": "String",
						"defaultValue": "2026-11-15T06:00:00Z"
					},
					"toUtc": {
						"type": "String",
						"defaultValue": "2026-11-16T06:00:00Z"
					},
					"batchId": {
						"type": "String",
						"defaultValue": "batch-02"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-11-23T12:23:47Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_retail_crm_cosmos')]",
				"[concat(variables('factoryId'), '/datasets/ds_retail_crm_landing')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_retail_pos_sql_ingest')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy_orders",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('SELECT o.order_id, o.customer_id, CONVERT(varchar(19), CAST(SWITCHOFFSET(o.order_timestamp, ''+00:00'') AS datetime2(0)), 126) + ''Z'' AS order_timestamp, CONVERT(varchar(19), CAST(SWITCHOFFSET(o.updated_at, ''+00:00'') AS datetime2(0)), 126) + ''Z'' AS updated_at, o.status FROM dbo.orders o WHERE o.updated_at > CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.fromUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''') AND o.updated_at <= CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.toUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''')')",
									"type": "Expression"
								},
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".csv"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_retail_pos_sql",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "orders"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_retail_pos_landing_csv",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "orders",
									"batchId": {
										"value": "@pipeline().parameters.batchId",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "Copy_order_items",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('SELECT i.order_item_id,i.order_id,i.product_id,i.quantity,i.unit_price FROM dbo.order_items i JOIN dbo.orders o ON o.order_id=i.order_id WHERE o.updated_at > CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.fromUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''') AND o.updated_at <= CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.toUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''')')",
									"type": "Expression"
								},
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobStorageWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".csv"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_retail_pos_sql",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "order_items"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_retail_pos_landing_csv",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "order_items",
									"batchId": {
										"value": "@pipeline().parameters.batchId",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "Copy_payments",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat('SELECT p.payment_id,p.order_id,p.amount,p.currency,p.method FROM dbo.payments p JOIN dbo.orders o ON o.order_id=p.order_id WHERE o.updated_at > CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.fromUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''') AND o.updated_at <= CONVERT(datetimeoffset(0), ''', formatDateTime(pipeline().parameters.toUtc, 'yyyy-MM-ddTHH:mm:ssZ'), ''')')",
									"type": "Expression"
								},
								"partitionOption": "None"
							},
							"sink": {
								"type": "DelimitedTextSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "DelimitedTextWriteSettings",
									"quoteAllText": true,
									"fileExtension": ".csv"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "ds_retail_pos_sql",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "payments"
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_retail_pos_landing_csv",
								"type": "DatasetReference",
								"parameters": {
									"tableName": "payments",
									"batchId": {
										"value": "@pipeline().parameters.batchId",
										"type": "Expression"
									}
								}
							}
						]
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
